// WordStar 連線魔王戰 — Realtime Database 安全性規則
// 貼到 Firebase 主控台 → Realtime Database → 規則 → 發布
//
// 這份規則是照 word-star.html 裡實際的寫入路徑寫的，不是通用範本。
// 沒寫在這裡的路徑一律拒絕（RTDB 預設就是 deny），所以不用另外寫封鎖規則。
{
  "rules": {
    "rooms": {
      "$code": {
        // 要加入房間得先讀得到 meta，所以登入後可讀。
        ".read": "auth != null",
        ".validate": "$code.matches(/^[0-9]{4}$/)",

        // 開房：房號沒被占用時才能整個建立，而且 meta.host 必須是自己。
        // 另外允許房主刪掉自己的房間 —— 沒有這條的話房間只進不出，資料會一直累積，
        // 而且房號用過就再也開不了（建立規則要求該節點不存在）。
        ".write": "auth != null && ((!data.exists() && newData.child('meta/host').val() === auth.uid) || (!newData.exists() && data.child('meta/host').val() === auth.uid))",

        "meta": {
          // 房主可以改 meta 底下任何東西（難度、關門、開打時間）。
          // 這條寫在 meta 這層，往下的子節點會繼承，不必再依賴萬用字元。
          ".write": "auth != null && root.child('rooms/'+$code+'/meta/host').val() === auth.uid",

          // 勝利／全班重修是「誰先搶到誰宣告」，不需要房主還活著，
          // 所以這三個欄位額外開放給房內任何玩家寫。
          "state": {
            ".write": "auth != null && root.child('rooms/'+$code+'/players/'+auth.uid).exists()",
            ".validate": "newData.isString() && newData.val().matches(/^(lobby|playing|won|wiped)$/)"
          },
          "lastHit": {
            ".write": "auth != null && root.child('rooms/'+$code+'/players/'+auth.uid).exists()",
            ".validate": "newData.isString()"
          },
          "endAt": {
            ".write": "auth != null && root.child('rooms/'+$code+'/players/'+auth.uid).exists()",
            ".validate": "newData.isNumber()"
          },
          "host": { ".validate": "newData.isString()" },
          "tier": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3" },
          "locked": { ".validate": "newData.isBoolean()" }
        },

        "seed": {
          ".write": "auth != null && root.child('rooms/'+$code+'/meta/host').val() === auth.uid",
          ".validate": "newData.isString()"
        },

        "boss": {
          // 多人同時扣血是 transaction，所以房內玩家都要能寫。
          ".write": "auth != null && root.child('rooms/'+$code+'/players/'+auth.uid).exists()",
          "hp": {
            // 血量只能往下扣。唯一例外是「還在大廳、而且是房主」的初始設定 ——
            // 這個例外一定要綁時機，否則房主整場都能把魔王補滿。
            // !data.exists() 這段必須放最前面：血量還不存在時 data.val() 是 null，
            // 拿數字去跟 null 比較會讓整條 validate 判定失敗（不是回傳 false），
            // 連房主開打寫入初始血量都會被擋掉。
            ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() <= data.val() || (root.child('rooms/'+$code+'/meta/state').val() === 'lobby' && root.child('rooms/'+$code+'/meta/host').val() === auth.uid))"
          },
          "maxHp": { ".validate": "newData.isNumber() && newData.val() > 0" }
        },

        "players": {
          "$uid": {
            // 自己那格自己寫。另外允許「補考」：活著的隊友把倒地的人拉起來，
            // 而且只准 alive false→true 這個方向，不能拿來互相亂改。
            ".write": "auth != null && ($uid === auth.uid || (root.child('rooms/'+$code+'/players/'+auth.uid+'/alive').val() === true && data.child('alive').val() === false && newData.child('alive').val() === true))",
            ".validate": "newData.hasChildren(['name','hp'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12" },
            "hp": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300" },
            "alive": { ".validate": "newData.isBoolean()" },
            "dmg": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "online": { ".validate": "newData.isBoolean()" },
            "joinAt": { ".validate": "newData.isNumber()" }
          }
        }
      }
    }
  }
}
